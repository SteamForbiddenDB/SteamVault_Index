{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "updated_at": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,120}$"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}